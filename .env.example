# OpenAI-Compatible AI Agent & Vision Service (Primary)
# Supports OpenAI, OpenRouter, Groq, DeepSeek, Ollama, vLLM, LiteLLM, etc.
AI_BASE_URL="https://api.openai.com/v1"
AI_KEY="MY_AI_API_KEY"
AI_MODEL="gpt-4o-mini"

# GEMINI_API_KEY: Optional fallback when AI_KEY is not configured.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PostgreSQL Connection (Supabase / PostgreSQL)
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="postgres"
DB_USER="postgres"
DB_PASSWORD="MY_DB_PASSWORD"
DB_SSL="true"

# AUTH_SECRET: HMAC / JWT signing secret for session cookies
AUTH_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"
